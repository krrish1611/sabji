# ============================================================
#  SABJIS – FARM FRESH DELIVERY  |  Environment Variables
# ============================================================
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================


# ── SERVER ──────────────────────────────────────────────────
# Port the Express backend listens on (Render sets this automatically)
PORT=3000

# Set to "true" when deployed on Render (enables Render-specific behaviour)
RENDER=false

# Node environment: "development" | "production"
NODE_ENV=development


# ── FRONTEND / CORS ─────────────────────────────────────────
# Public URL of your deployed Netlify frontend
FRONTEND_URL=https://your-site.netlify.app

# Single additional CORS origin (optional)
CORS_ORIGIN=https://your-site.netlify.app

# Comma-separated list of extra allowed origins (optional)
ALLOWED_ORIGINS=https://your-site.netlify.app,https://www.yourdomain.com

# URL the frontend uses to reach the backend API
# Leave empty in local dev (Vite proxy handles /api → localhost:3000)
VITE_API_URL=https://your-backend.onrender.com


# ── SUPABASE (Backend / Server-side) ────────────────────────
# Project URL from Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role key (has full DB access – keep SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon / public key (fallback if service role key is not set)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── SUPABASE (Frontend / Client-side, exposed via Vite) ─────
# These VITE_ prefixed variables are bundled into the browser build.
# Use only the PUBLIC anon key here — NEVER the service role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# ── RAZORPAY ────────────────────────────────────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# Use test keys (rzp_test_...) for development, live keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret — set in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here


# ── GOOGLE GEMINI AI ─────────────────────────────────────────
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...


# ── ADMIN ACCOUNT (Default seed credentials) ─────────────────
# These are used to seed the initial admin user on first run.
# Change these immediately after first login!
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_NAME=Admin Name
ADMIN_PASSWORD=ChangeMe@123
ADMIN_PHONE=9999999999


# ── SMTP / EMAIL ─────────────────────────────────────────────
# Used for password reset and order confirmation emails.
# Works with any SMTP provider: Gmail, SendGrid, Mailgun, Brevo, etc.
#
# Example – Gmail App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   ← Gmail App Password (not your login password)
#
# Example – SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=SG.xxxxxxx
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# "From" name/address shown in sent emails (optional – defaults to SMTP_USER)
EMAIL_FROM=Sabjis Fresh <noreply@yourdomain.com>

